[branch]
	sort = "-committerdate"

[column]
	ui = "auto"

[commit]
	gpgSign = true

[core]
	editor = "vim"

[alias]
  s = "status --short"
  fs = "status"
  aa = "add -A"
  fd = "!git diff --staged && git diff && for f in $(git ls-files --others --exclude-standard); do git diff --no-index /dev/null \"$f\"; done"
  ll = "log -n5 --pretty=oneline"
  c = "commit"
  ca = "commit --amend"
  can = "commit --amend --no-edit"

[gpg]
	format = "ssh"

[init]
	defaultBranch = "main"

[tag]
	gpgSign = true

[user]
	email = "git.marekjulien@pm.me"
	name = "MarekJulien"
	signingKey = "~/keys/ssh/github_keys/github.pub"

[includeIf "gitdir:/home/beaver/thm/**"]
	path = "~/.config/git/thm-config"

[includeIf "gitdir:/home/*/repos/codeberg/**"]
	path = "~/.config/git/codeberg-config"
